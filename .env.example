# Public URL of the site (used for metadata, sitemap, OG links).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://derrickomanwa.com

# Contact form (https://resend.com/api-keys)
RESEND_API_KEY=
# Where contact form messages are delivered (comma-separate multiple addresses).
CONTACT_TO_EMAIL=
# Sender. Must be on a domain verified in Resend. Leave unset to use
# Resend's test sender (only delivers to the Resend account owner's address).
CONTACT_FROM_EMAIL="Derrick Omanwa <hello@yourdomain.com>"
